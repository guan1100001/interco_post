# 复制为 .env 后按需修改；真实密钥只放 .env，不要提交代码库

# 数据库（相对项目根目录或绝对路径；与三个遗留脚本共用同一文件）
DB_PATH=interco_ontology.db

# OCR：auto=真实服务不可用时自动降级为模拟数据；live=必须真实识别；mock=强制模拟
# 注意：auto / mock 产生的是模拟数据，仅用于演示流程，不能作为真实过账依据。
OCR_MODE=auto
OCR_URL=http://10.238.67.9:8014/ocr
OCR_TIMEOUT=8
# 内网 OCR 应直连。默认 false：程序会绕过系统 HTTP_PROXY/HTTPS_PROXY（例如 127.0.0.1:53824），
# 否则会出现 ProxyError / 远程主机强迫关闭连接(10054)。仅当 OCR 服务确实需要走代理时才设为 true。
OCR_USE_ENV_PROXY=false
# auto 模式确认 OCR 服务不可达后，多少秒内直接降级、不再逐张等待超时
# 设为 0 表示每次都尝试真实 OCR
OCR_DOWN_COOLDOWN_SEC=300

# SAP：mock=生成模拟凭证并完整落库（默认）；dry_run=仅校验与预览；live=调用真实 BAPI
# 这里是「服务启动默认值」：界面「过账模式」下拉可在运行时切换，切换只在本进程生效，
# 重启后自动回落到这里的 SAP_MODE（安全默认，避免误对真实 SAP 持续过账）。
SAP_MODE=mock
# 真实过账（live）必填（占位，勿写入真实值到本文件）。
# 注意：若这里直接写 SAP_MODE=live 但下面 4 项留空，后端启动会快速失败并提示缺少哪些配置；
# 若要长期以 live 运行，请补齐 4 项后重启后端。界面切到 live 但凭据未配时，
# 「确认过账」会明确报错，不会生成模拟凭证、也不会连到真实 SAP。
WSDL_URL_ZCOA003=
SERVICE_URL_ZCOA003=
USERNAME_300=
PASSWORD_300=
# SAP SOAP 为内网直连，默认绕过本机系统代理（与 OCR 一致）；确实需要代理时才设为 true
SAP_USE_ENV_PROXY=false

# 服务
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=INFO

# 可选：限制可访问的发票目录（逗号分隔绝对路径），留空表示不限制（仅本地只读）
INVOICE_ROOTS=
# 可选：自定义前端构建产物目录，默认 frontend/dist
FRONTEND_DIST=

# ---- 登录认证与授权 ----
# JWT 签名密钥：生产环境必须显式配置足够长的随机串；留空时首次启动自动生成到 .auth_secret（已 gitignore）
AUTH_SECRET_KEY=
AUTH_ISSUER=interco-invoice-console
AUTH_AUDIENCE=interco-console-web
# 访问令牌有效期（分钟，仅存浏览器内存）；刷新令牌有效期（天，HttpOnly Cookie + 服务端可撤销）
AUTH_ACCESS_TTL_MIN=30
AUTH_REFRESH_TTL_DAYS=7
AUTH_COOKIE_NAME=interco_refresh
# 仅 HTTPS 部署时改为 true
AUTH_COOKIE_SECURE=false
# 连续失败锁定策略
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
# 首次启动且 users 表为空时创建的管理员；密码留空则随机生成并写入 .initial_admin_password（已 gitignore）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
