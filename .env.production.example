# ---------------------------------------------------------------------------
# 生产 / Rainbond 环境变量模板
# 用法：复制为 .env.production 本机验证；上 Rainbond 时在组件「环境变量」逐项填写。
# 严禁把真实 SAP 凭据、JWT 密钥写进本文件或提交到 Git 仓库。
# ---------------------------------------------------------------------------

# 容器内必须监听 0.0.0.0，本地开发的 127.0.0.1 会让网关探针全部失败
HOST=0.0.0.0
PORT=8000

# 必须指向持久卷；写 /app/interco_ontology.db 会在组件重建时丢数据。
# .auth_secret（JWT 密钥）与 .initial_admin_password 也会写到 DB_PATH 同目录，
# 二者随同一个卷保留，重建后已登录用户不会被强制登出。
DB_PATH=/app/data/interco_ontology.db
INVOICE_ROOTS=/app/invoices
FRONTEND_DIST=/app/frontend/dist

# 前端「发票文件夹」要填容器内路径，例如 /app/invoices/2026-11，
# 不能填 Windows 的 D:\... 路径（容器内不存在）
LOG_LEVEL=INFO

# ---- OCR ----
# 公有云（Rainbond Cloud）访问不到 10.238.67.9 内网 OCR，只能 mock 演示。
# 内网自建 Rainbond 且能连通 OCR 服务时，改为 auto 或 live。
OCR_MODE=mock
OCR_URL=http://10.238.67.9:8014/ocr
OCR_TIMEOUT=8
OCR_USE_ENV_PROXY=false
OCR_DOWN_COOLDOWN_SEC=300

# ---- SAP 过账 ----
# 服务启动默认值；界面可在运行时切换，重启后回落到这里。
# 真实 live 需要内网 WSDL + 4 项凭据，且不建议把 SAP 生产账号放公有云。
SAP_MODE=mock
SAP_USE_ENV_PROXY=false
WSDL_URL_ZCOA003=
SERVICE_URL_ZCOA003=
USERNAME_300=
PASSWORD_300=

# ---- 对外访问 / 认证 ----
# 同源部署用不到 CORS；如通过独立域名访问前端，把这里换成实际域名（逗号分隔）
CORS_ORIGINS=https://your-domain.example.com
# 通过 HTTPS 对外时必须为 true，否则刷新令牌 Cookie 不会下发
AUTH_COOKIE_SECURE=true
AUTH_SECRET_KEY=
AUTH_ISSUER=interco-invoice-console
AUTH_AUDIENCE=interco-console-web
AUTH_ACCESS_TTL_MIN=30
AUTH_REFRESH_TTL_DAYS=7
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
# 首次启动且 users 表为空时创建管理员；务必显式设置强密码
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
